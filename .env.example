# Supabase → Project Settings → API
# URL проекта
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Публичный ключ (в новой панели он называется publishable / anon)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Только для ежедневной уборки файлов (/api/cron/sweep).
# Обходит RLS — никогда не давать префикс NEXT_PUBLIC_ и не коммитить.
SUPABASE_SERVICE_ROLE_KEY=
# Любая случайная строка: Vercel шлёт её в заголовке Authorization при запуске cron
CRON_SECRET=
